# Copy to .env, then set your own key. Never commit .env.
SEEGROUND_API_KEY=
SEEGROUND_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
SEEGROUND_MODEL=qwen3.7-plus
SEEGROUND_API_PROVIDER=openai
SEEGROUND_REACT_BACKEND=openai
SEEGROUND_ENABLE_THINKING=1
SEEGROUND_THINKING_TOKEN_FLOOR=8192
SEEGROUND_OPENAI_TOKEN_PARAMETER=max_completion_tokens
SEEGROUND_OPENAI_TEMPERATURE=0
