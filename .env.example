# Local vLLM through an SSH tunnel to remote port 8000. Never commit .env.
# Switch EVIGROUND_MODEL to qwen2-vl-2b when that model is served.
EVIGROUND_API_KEY=EMPTY
EVIGROUND_BASE_URL=http://127.0.0.1:18000/v1
EVIGROUND_MODEL=qwen2-vl-72b
EVIGROUND_API_PROVIDER=openai
EVIGROUND_ENABLE_THINKING=0
EVIGROUND_THINKING_TOKEN_FLOOR=8192
EVIGROUND_OPENAI_TOKEN_PARAMETER=max_tokens
EVIGROUND_OPENAI_TEMPERATURE=0
EVIGROUND_API_READ_TIMEOUT=900
# Qwen wrapper enables these; requires compact prompts and a Guidance vLLM engine.
EVIGROUND_ACTION_NO_REPEAT=0
EVIGROUND_GUIDED_DECODING_BACKEND=
# Experimental compact DAG serialization; default snapshot preserves existing output.
# delta requires EVIGROUND_PROMPT_PROFILE=compact and EVIGROUND_DAG_MONITOR_ENABLED=1.
EVIGROUND_DAG_WIRE_FORMAT=snapshot
