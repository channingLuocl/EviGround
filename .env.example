# Copy to .env, then set your own key. Never commit .env.
EVIGROUND_API_KEY=
EVIGROUND_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
EVIGROUND_MODEL=qwen3.7-plus
EVIGROUND_API_PROVIDER=openai
EVIGROUND_REACT_BACKEND=openai
EVIGROUND_ENABLE_THINKING=1
EVIGROUND_THINKING_TOKEN_FLOOR=8192
EVIGROUND_OPENAI_TOKEN_PARAMETER=max_completion_tokens
EVIGROUND_OPENAI_TEMPERATURE=0
