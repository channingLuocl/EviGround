# OpenAI-compatible base URL ending in /v1, not /chat/completions.
SEEGROUND_BASE_URL=
SEEGROUND_MODEL=
SEEGROUND_API_KEY=
# Outer active_diagnostic planner; qwen is available as a text-only comparison.
SEEGROUND_REACT_BACKEND=jev
# JEV planner and frozen-evidence decision comparison.
TYPESAFE_API_KEY=
SEEGROUND_JEV_MODEL=jev-latest
SEEGROUND_CONTEXT_LIMIT=131072
# Local sample workers and outbound API requests are controlled separately.
SEEGROUND_API_CONCURRENCY=4
# The batch runner sets a run-specific directory automatically.
SEEGROUND_API_SLOT_DIR=
# Enable v6.2 strict response schemas for the OpenAI-compatible production stages.
SEEGROUND_V62=0
